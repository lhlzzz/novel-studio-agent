# meiti root DB (PostgreSQL + pgvector)
DATABASE_URL=postgresql://meiti:meiti@localhost:5445/meiti
MEITI_DATABASE_URL=postgresql://meiti:meiti@localhost:5445/meiti

# Optional embedding metadata defaults
MEITI_EMBEDDING_DIM=1536
MEITI_EMBEDDING_MODEL=text-embedding-3-small

# Native social OAuth (never commit secrets)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_ACCESS_TOKEN=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Read-only research infrastructure (optional)
SCRAPECREATORS_API_KEY=

# Generation infrastructure (never commit secrets)
LECHUANG_API_URL=
LECHUANG_API_KEY=

# AI Gateway (vision / optional generation). Credential reuse is allowed; identity is not Lechuang.
AI_GATEWAY_API_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_VISION_MODEL=

# Durable social credential store (never /tmp in production)
MEITI_SECRET_DIR=

# CN social OAuth
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_REDIRECT_URI=
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=
KUAISHOU_REDIRECT_URI=
XIANYU_APP_KEY=
XIANYU_APP_SECRET=
XIANYU_REDIRECT_URI=
MEITI_XIANYU_DEPLOYMENT_MODE=LOCAL
XHS_CLIENT_ID=
XHS_REDIRECT_URI=
MEITI_XHS_HANDOFF_DIR=
