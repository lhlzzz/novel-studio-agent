# meiti root DB (PostgreSQL + pgvector)
DATABASE_URL=postgresql://meiti:meiti@localhost:5445/meiti
MEITI_DATABASE_URL=postgresql://meiti:meiti@localhost:5445/meiti

# Optional embedding metadata defaults
MEITI_EMBEDDING_DIM=1536
MEITI_EMBEDDING_MODEL=text-embedding-3-small

# Distribution infrastructure (never commit secrets)
POSTIZ_API_URL=http://127.0.0.1:4007
POSTIZ_API_KEY=

# Read-only research infrastructure (optional)
SCRAPECREATORS_API_KEY=
